# Build stage
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Force pnpm to use flat node_modules (fixes symlink issues in Docker)
RUN echo "node-linker=hoisted" > .npmrc

# Copy package files (without lockfile - let pnpm regenerate with hoisted mode)
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies with flat structure
RUN pnpm install

# Copy source files
COPY apps/api ./apps/api
COPY tsconfig.json ./

# Build the API
RUN cd apps/api && pnpm build

# Migration stage (has devDependencies for drizzle-kit)
FROM builder AS migrator

WORKDIR /app/apps/api

CMD ["pnpm", "db:migrate"]

# Production stage
FROM node:20-alpine AS runner

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Force pnpm to use flat node_modules (fixes symlink issues in Docker)
RUN echo "node-linker=hoisted" > .npmrc

# Copy package files (without lockfile)
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install production dependencies only
RUN pnpm install --prod

# Copy built files
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Set environment
ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "apps/api/dist/index.js"]
